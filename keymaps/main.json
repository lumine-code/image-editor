{
  ".image-editor-list .select-list": {
    "alt-enter": "image-editor:open-selected-with",
    "ctrl-alt-enter": "image-editor:open-selected-external",
    "alt-shift-enter": "image-editor:show-selected-in-folder"
  },
  ".image-editor-list .select-list lumine-text-editor[mini]": {
    "alt-enter": "image-editor:open-selected-with",
    "ctrl-alt-enter": "image-editor:open-selected-external",
    "alt-shift-enter": "image-editor:show-selected-in-folder"
  },
  ".image-editor": {
    "up": "image-editor:scroll-up",
    "down": "image-editor:scroll-down",
    "left": "image-editor:scroll-left",
    "right": "image-editor:scroll-right",
    "+": "image-editor:zoom-in",
    "=": "image-editor:zoom-in",
    "-": "image-editor:zoom-out",
    "_": "image-editor:zoom-out",
    "0": "image-editor:zoom-100",
    "cmdorctrl-=": "image-editor:zoom-next-level",
    "cmdorctrl-+": "image-editor:zoom-next-level",
    "cmdorctrl--": "image-editor:zoom-previous-level",
    "cmdorctrl-_": "image-editor:zoom-previous-level",
    "cmdorctrl-0": "image-editor:zoom-100",
    "r": "image-editor:reload",
    "8": "image-editor:center",
    "f": "image-editor:fit-to-view",
    "b": "image-editor:blur-medium",
    "s": "image-editor:sharpen-medium",
    "x": "image-editor:crop-to-selection",
    "shift-x": "image-editor:resize-canvas-to-selection",
    "]": "image-editor:rotate-90-cw",
    "[": "image-editor:rotate-90-ccw",
    "h": "image-editor:flip-horizontal",
    "v": "image-editor:flip-vertical",
    "g": "image-editor:list",
    "shift-g": "image-editor:grayscale",
    "i": "image-editor:invert-colors",
    "c": "image-editor:copy-selection",
    "a": "image-editor:automatic-zoom",
    "q": "image-editor:auto-select",
    "w": "image-editor:fit-width",
    "e": "image-editor:select-visible-area",
    "z": "image-editor:undo",
    "y": "image-editor:redo",
    "pageup": "image-editor:previous-image",
    "pagedown": "image-editor:next-image",
    "home": "image-editor:first-image",
    "end": "image-editor:last-image"
  },
